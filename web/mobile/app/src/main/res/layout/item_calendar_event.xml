<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="24dp">

    <!-- Date Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="56dp"
        android:layout_height="72dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#DFE2DD"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEventDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#11231D"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="11" />

            <TextView
                android:id="@+id/tvEventMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8D9691"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                tools:text="SEP" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Event Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <!-- Category Tag -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardEventCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FCEBEA"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvEventCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:textColor="#CC4E42"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Advisory" />
        </androidx.cardview.widget.CardView>

        <!-- Title -->
        <TextView
            android:id="@+id/tvEventTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#11231D"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Water interruption on Rizal St." />

        <!-- Time/Location -->
        <TextView
            android:id="@+id/tvEventTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#8D9691"
            android:textSize="14sp"
            tools:text="8:00 AM – 2:00 PM" />
    </LinearLayout>
</LinearLayout>