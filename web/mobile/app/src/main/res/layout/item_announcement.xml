<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Line & Dot -->
    <RelativeLayout
        android:layout_width="20dp"
        android:layout_height="match_parent">

        <!-- Timeline Line -->
        <View
            android:id="@+id/timelineLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="6dp"
            android:background="#DFE2DD" />

        <!-- Timeline Dot -->
        <androidx.cardview.widget.CardView
            android:id="@+id/timelineDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#CC4E42"
            app:cardCornerRadius="5dp"
            app:cardElevation="0dp" />
    </RelativeLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/categoryCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FCEBEA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/categoryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:textColor="#CC4E42"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Advisory" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#8D9691"
                android:textSize="12sp"
                tools:text="Sept 9" />
        </LinearLayout>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#20312B"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Water interruption on Rizal St." />

        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="4dp"
            android:textColor="#737973"
            android:textSize="14sp"
            tools:text="Maintenance work on the main line, 8:00 AM–2:00 PM. Store extra water beforehand." />
    </LinearLayout>
</LinearLayout>