<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Dynamic Left Color Strip (Changes based on status) -->
            <View
                android:id="@+id/statusColorStrip"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="#DBA03B"
                tools:background="#DBA03B" />

            <!-- Main Content Area -->
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="16dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvRequestType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#11231D"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Report" />

                <!-- Action Icon (Chat bubble placeholder on right) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/iconContainer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignTop="@id/tvRequestType"
                    app:cardBackgroundColor="#DDF0EC"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <!-- Placeholder for message/chat icon -->
                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:background="#247D76" />
                </androidx.cardview.widget.CardView>

                <!-- Description / Subtitle -->
                <TextView
                    android:id="@+id/tvRequestDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvRequestType"
                    android:layout_marginTop="4dp"
                    android:layout_toStartOf="@id/iconContainer"
                    android:layout_marginEnd="8dp"
                    android:textColor="#6A756F"
                    android:textSize="16sp"
                    tools:text="Blocked drainage, Purok 3" />

                <!-- Date/Time Submitted -->
                <TextView
                    android:id="@+id/tvRequestDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvRequestDesc"
                    android:layout_marginTop="12dp"
                    android:textColor="#8D9691"
                    android:textSize="14sp"
                    tools:text="Submitted on Sept 7, 2026 · 9:14 AM" />

                <!-- Status Chip -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRequestStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvRequestDate"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#FDF1DA"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tvRequestStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textColor="#DBA03B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Pending" />
                </androidx.cardview.widget.CardView>

            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>