<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- Date Separator Header -->
    <!-- In your adapter, set this to GONE if the notification is on the same day as the previous one -->
    <LinearLayout
        android:id="@+id/dateSeparatorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="16dp">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#DFE2DD" />

        <TextView
            android:id="@+id/tvDateHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:textColor="#6A756F"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Sept 9, 2026 · Wed" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#DFE2DD" />
    </LinearLayout>

    <!-- Notification Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Icon Background Container -->
            <androidx.cardview.widget.CardView
                android:id="@+id/iconContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="#DDF0EC"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <!-- Placeholder for the actual icon -->
                <View
                    android:id="@+id/iconImage"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="#247D76" />
            </androidx.cardview.widget.CardView>

            <!-- Unread Dot (Top Right) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/unreadDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="#CC4E42"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp" />

            <!-- Text Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/unreadDot"
                android:layout_toEndOf="@id/iconContainer"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvNotificationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#11231D"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Your clearance is ready for pickup" />

                <TextView
                    android:id="@+id/tvNotificationDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#737973"
                    android:textSize="14sp"
                    tools:text="Request update · Barangay office · 10 minutes ago" />
            </LinearLayout>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>